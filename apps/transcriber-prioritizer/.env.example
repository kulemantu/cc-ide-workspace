# transcriber-prioritizer — environment template.
# Copy to `.env` (gitignored), fill in the value, then load it:
#   cp .env.example .env
#   set -a; . .env; set +a
# The key is read from the environment only — never passed on argv (secrets hygiene).

# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
